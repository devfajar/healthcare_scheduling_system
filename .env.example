# ==========================================
# Healthcare Scheduling System - Environment Variables Template
# ==========================================

# Application Configuration
PORT=3001
NODE_ENV=development
# CORS Origin: comma-separated list of allowed frontend URLs (e.g. http://localhost:3000,http://localhost:5173) or * for all
CORS_ORIGIN=*

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=healthcare_auth

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=1d
