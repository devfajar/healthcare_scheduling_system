# ==========================================
# Healthcare Scheduling System - Environment Variables Template
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=healthcare_db

# Auth Microservice Configuration (Port 3001)
AUTH_SERVICE_PORT=3001
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=1d

# Schedule Microservice Configuration (Port 3002)
SCHEDULE_SERVICE_PORT=3002
AUTH_SERVICE_URL=http://auth-service:3001

# Notification Microservice Configuration (Port 3003)
NOTIFICATION_SERVICE_PORT=3003

# Redis Configuration (Bull Queue)
REDIS_HOST=redis
REDIS_PORT=6379

# Email Notification / SMTP Configuration (Optional: fallback to JSON transport if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healthcare.com

# CORS Configuration
CORS_ORIGIN=*
