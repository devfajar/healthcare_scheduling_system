# Application Port & Environment
PORT=3002
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (PostgreSQL - healthcare_db)
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/healthcare_db?schema=public

# Inter-Service Authentication (Auth Service)
AUTH_SERVICE_URL=http://localhost:3001

# Redis Configuration (Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Notification / SMTP Configuration (Optional: fallback to JSON transport if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healthcare.com
