  "item": [
    {
      "name": "1. Auth Service (Port 3001)",
      "item": [
        {
          "name": "GraphQL - Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.data && responseJson.data.register && responseJson.data.register.accessToken) {",
                  "    pm.collectionVariables.set('auth_token', responseJson.data.register.accessToken);",
                  "    console.log('Saved auth_token from registration:', responseJson.data.register.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RegisterUser($input: RegisterInput!) {\n  register(input: $input) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"fajar@test.com\",\n    \"password\": \"Password1234!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/graphql",
              "host": ["{{auth_base_url}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "GraphQL - Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.data && responseJson.data.login && responseJson.data.login.accessToken) {",
                  "    pm.collectionVariables.set('auth_token', responseJson.data.login.accessToken);",
                  "    console.log('Saved auth_token from login:', responseJson.data.login.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginUser($input: LoginInput!) {\n  login(input: $input) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"fajar@test.com\",\n    \"password\": \"Password1234!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/graphql",
              "host": ["{{auth_base_url}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "GraphQL - Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken($input: ValidateTokenInput!) {\n  validateToken(input: $input) {\n    isValid\n    message\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"token\": \"{{auth_token}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/graphql",
              "host": ["{{auth_base_url}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "REST - Validate Token (Called by Schedule Service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{auth_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/validate",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "validate"]
            }
          }
        }
      ]
