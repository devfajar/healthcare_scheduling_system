  "item": [
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();\nif (responseJson.data && responseJson.data.register && responseJson.data.register.accessToken) {\n    pm.collectionVariables.set('auth_token', responseJson.data.register.accessToken);\n    console.log('Saved auth_token from registration:', responseJson.data.register.accessToken);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RegisterUser($input: RegisterInput!) {\n  register(input: $input) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"dr.fajar@test.com\",\n    \"password\": \"Password1234!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Registers a new user with email & password, returning JWT access token and user info without password."
          },
          "response": []
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();\nif (responseJson.data && responseJson.data.login && responseJson.data.login.accessToken) {\n    pm.collectionVariables.set('auth_token', responseJson.data.login.accessToken);\n    console.log('Saved auth_token from login:', responseJson.data.login.accessToken);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginUser($input: LoginInput!) {\n  login(input: $input) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"dr.fajar@test.com\",\n    \"password\": \"Password1234!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Authenticates user credentials and generates a new JWT access token."
          },
          "response": []
        },
        {
          "name": "3. Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken($input: ValidateTokenInput!) {\n  validateToken(input: $input) {\n    isValid\n    message\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"token\": \"{{auth_token}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Validates a JWT token and returns validity flag along with sanitized user details."
          },
          "response": []
        },
        {
          "name": "4. Get Current User (me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetCurrentUserProfile {\n  me {\n    id\n    email\n    createdAt\n    updatedAt\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Fetches profile of currently logged in user using Authorization: Bearer <token>."
          },
          "response": []
        }
      ]
    },
