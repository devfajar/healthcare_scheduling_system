                "query": "mutation CreateSchedule($input: CreateScheduleInput!) {\n  createSchedule(input: $input) {\n    id\n    objective\n    customerId\n    doctorId\n    scheduledAt\n    createdAt\n    customer {\n      name\n      email\n    }\n    doctor {\n      name\n    }\n  }\n}",
