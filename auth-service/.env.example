# ==========================================
# Auth Service Environment Variables Template
# ==========================================

# Application Port & Environment
PORT=3001
NODE_ENV=development
# CORS Origin: comma-separated list of allowed frontend URLs (e.g. http://localhost:3000,http://localhost:5173) or * for all
CORS_ORIGIN=*

# Database Connection String (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/healthcare_auth?schema=public

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=1d
